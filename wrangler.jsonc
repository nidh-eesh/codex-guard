{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-guard",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // Off: invocation logs record request URLs, and the SDK's error logs include
  // instance names; both contain workspace IDs, which are never logged
  "observability": { "enabled": false },
  "routes": [{ "pattern": "codexguard.nidheesh.me", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent"
      },
      // The day's review budget (D12): a plain Durable Object per UTC date
      {
        "class_name": "NeuronBudget",
        "name": "NEURON_BUDGET"
      }
    ]
  },
  // Per-IP limits (D12), keyed by the IP read when the WebSocket connects
  "ratelimits": [
    {
      "name": "REVIEW_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "workflows": [
    {
      "name": "review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow"
    }
  ],
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["NeuronBudget"],
      "tag": "v2"
    }
  ]
}
